# Redis connection
REDIS_URL=redis://redis:6379/0

# Data directory for uploads and results
DATA_DIR=/data

# Maximum upload size in MB
MAX_UPLOAD_MB=15

# Logging level
LOG_LEVEL=INFO

# Pre-warm model on startup (1=yes, 0=no)
MODEL_PREWARM=1

# CORS allowed origins (comma-separated)
CORS_ALLOW_ORIGINS=*
